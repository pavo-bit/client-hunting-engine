# Safe placeholders only — never commit real secrets. Copy to .env for local dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agency_intel
POSTGRES_PORT=5434
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5434/agency_intel_test
TEST_NOACCESS_URL=postgresql://noaccess:CHANGE-ME-TOO@127.0.0.1:5434/agency_intel_test
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5434/agency_intel
APP_NOACCESS_USER=noaccess
APP_NOACCESS_PASSWORD=change-me
# AUTH-001 operator credential. Provision with `node scripts/operator.mjs init`
# (prints these two lines; paste them into your UNTRACKED .env). Placeholders
# below keep every route fail-closed until a real credential is provisioned.
# CRITICAL: Next.js expands $VAR inside .env at boot. The printed hash escapes
# every $ as \$ — paste the line EXACTLY as printed. An unescaped hash is
# silently mangled, and the app then fails closed (login 503). Verify with:
#   node scripts/operator.mjs check .env
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD_HASH=
# Legacy bearer service credential for scripted API clients (optional).
# Empty = no bearer auth (NEVER open access). Set an explicit long random
# value only if scripts need it; browser login uses cookie sessions.
OPERATOR_API_TOKEN=
# Session + login-throttle tuning (safe defaults shown; all optional).
# AUTH_SESSION_TTL_SEC=43200
# AUTH_SESSION_MAX_SEC=86400
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_SEC=600
# AUTH_LOGIN_LOCK_SEC=600
# Isolated dev/test open mode. Honored ONLY when NODE_ENV != production.
# NEVER set this in production or on any exposed host.
# AUTH_DEV_OPEN=
